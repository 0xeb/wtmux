{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "msvc-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": { "CMAKE_C_COMPILER": "cl", "VCPKG_TARGET_TRIPLET": "x64-windows-static" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC x64 Release (Ninja)",
      "inherits": "msvc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC x64 Debug (Ninja)",
      "inherits": "msvc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "msvc-release-inbox",
      "displayName": "MSVC x64 Release, inbox ConPTY only (no package)",
      "inherits": "msvc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "TMUX_WIN32_CONPTY": "inbox" }
    },
    {
      "name": "msvc-x86-release",
      "displayName": "MSVC x86 (32-bit) Release; run from an x86 developer prompt",
      "inherits": "msvc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "VCPKG_TARGET_TRIPLET": "x86-windows-static" }
    },
    {
      "name": "msvc-arm64-release",
      "displayName": "MSVC ARM64 Release (cross-compiled); run from an amd64_arm64 developer prompt",
      "inherits": "msvc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_SYSTEM_NAME": "Windows", "CMAKE_SYSTEM_PROCESSOR": "ARM64", "VCPKG_TARGET_TRIPLET": "arm64-windows-static" }
    }
  ],
  "buildPresets": [
    { "name": "msvc-release", "configurePreset": "msvc-release" },
    { "name": "msvc-debug", "configurePreset": "msvc-debug" },
    { "name": "msvc-release-inbox", "configurePreset": "msvc-release-inbox" },
    { "name": "msvc-x86-release", "configurePreset": "msvc-x86-release" },
    { "name": "msvc-arm64-release", "configurePreset": "msvc-arm64-release" }
  ]
}
