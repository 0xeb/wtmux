#include <winver.h>

#ifdef WTMUX_RC_SERVICE
#define WTMUX_RC_DESCRIPTION	"wtmux service: tmux sessions on users' desktops"
#define WTMUX_RC_NAME		"wtmux-service"
#define WTMUX_RC_FILENAME	"wtmux-service.exe"
#else
#define WTMUX_RC_DESCRIPTION	"tmux for Windows"
#define WTMUX_RC_NAME		"tmux"
#define WTMUX_RC_FILENAME	"tmux.exe"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION	WTMUX_RELEASE_MAJOR, WTMUX_RELEASE_MINOR, WTMUX_RELEASE_PATCH, 0
PRODUCTVERSION	WTMUX_RELEASE_MAJOR, WTMUX_RELEASE_MINOR, WTMUX_RELEASE_PATCH, 0
FILEFLAGSMASK	VS_FFI_FILEFLAGSMASK
FILEFLAGS	0
FILEOS		VOS_NT_WINDOWS32
FILETYPE	VFT_APP
FILESUBTYPE	VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", WTMUX_RC_DESCRIPTION
			VALUE "FileVersion", WTMUX_FILE_VERSION
			VALUE "InternalName", WTMUX_RC_NAME
			VALUE "LegalCopyright", "Copyright (c) 2026 Elias Bachaalany. ISC licence; see COPYING"
			VALUE "OriginalFilename", WTMUX_RC_FILENAME
			VALUE "ProductName", "wtmux"
			VALUE "ProductVersion", WTMUX_RELEASE
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
